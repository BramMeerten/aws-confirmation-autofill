{
  "manifest_version": 3,
  "name": "AWS Confirmation Autofill",
  "version": "1.1.0",
  "description": "Automatically fills in confirmation text in AWS Console prompts without submitting.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aws-confirmation-autofill.BramMeerten@github.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.console.aws.amazon.com/*",
        "https://console.aws.amazon.com/*",
        "https://*.aws.amazon.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
